# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://reviews:reviews@localhost:5442/linella_reviews

# ---------------------------------------------------------------------------
# AI — OpenRouter (https://openrouter.ai/keys)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Any slug from https://openrouter.ai/models — a ":free" suffix costs nothing
# but is capped at 50 requests/day (1000/day once you've ever bought credits).
#
#   nvidia/nemotron-3-super-120b-a12b:free   free default; largest free model
#                                            that supports JSON mode
#   google/gemma-4-31b-it:free               free alternative, worth A/B testing
#                                            for Romanian
#   anthropic/claude-sonnet-5                paid, ~0.5 c/review, best quality
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Sent to OpenRouter for attribution in their dashboard/leaderboards.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Linella Reviews

# ---------------------------------------------------------------------------
# Review sources — comma-separated; they all run on each sync.
#   mock       seeded demo data, no keys needed (default)
#   outscraper Google, full history for any location, paid, read-only
#   serpapi    Google, partial history for any location, paid, read-only
#   gbp        Google Business Profile, free, needs ownership of the listings
#
# e.g. REVIEW_SOURCE=gbp
# ---------------------------------------------------------------------------
REVIEW_SOURCE=mock

# outscraper
OUTSCRAPER_API_KEY=
# Comma-separated Google place IDs or map URLs, one per Linella store.
OUTSCRAPER_PLACE_IDS=

# serpapi
SERPAPI_API_KEY=
SERPAPI_PLACE_IDS=

# Google Business Profile (OAuth refresh-token flow).
# The only source that can also PUBLISH replies — see PUBLISH_REPLIES below.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=

# Publishing replies straight to Google. Off by default: with this false the
# app only ever drafts and copies, which is the safe posture while you're still
# reading what the model writes. Turning it on adds a Publish button — still
# one explicit click plus a confirmation per reply, never automatic.
# Requires REVIEW_SOURCE to include gbp, and Google only accepts replies for
# locations that are verified in Business Profile.
PUBLISH_REPLIES=false

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Shared secret for POST /api/sync so a cron job can trigger it.
# Required: with this unset the endpoint refuses every request.
SYNC_SECRET=change-me

# Beta only. Shows one-click "sign in as admin/operator" buttons on the login
# page, backed by the demo accounts from `npm run user -- demo`.
# Leave false for anything holding real data.
ENABLE_QUICK_LOGIN=false
# Second latch: quick login refuses to run in a production build unless this is
# also true, so shipping the flag by accident fails safe.
ALLOW_QUICK_LOGIN_IN_PROD=false
