# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://reviews:reviews@localhost:5442/linella_reviews

# ---------------------------------------------------------------------------
# AI — OpenRouter (https://openrouter.ai/keys)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Sent to OpenRouter for attribution in their dashboard/leaderboards.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Linella Reviews

# ---------------------------------------------------------------------------
# Review source — which adapter fetches reviews.
#   mock       seeded demo data, no keys needed (default)
#   outscraper full history for any location, paid, read-only
#   serpapi    partial history for any location, paid, read-only
#   gbp        Google Business Profile, free, needs ownership of the listings
# ---------------------------------------------------------------------------
REVIEW_SOURCE=mock

# outscraper
OUTSCRAPER_API_KEY=
# Comma-separated Google place IDs or map URLs, one per Linella store.
OUTSCRAPER_PLACE_IDS=

# serpapi
SERPAPI_API_KEY=
SERPAPI_PLACE_IDS=

# Google Business Profile (OAuth refresh-token flow)
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=

# Shared secret for POST /api/sync so a cron job can trigger it.
SYNC_SECRET=change-me
